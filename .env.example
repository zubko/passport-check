# Copy this file to .env and fill in your Pushover credentials.
# The .env file is gitignored and must never be committed or read by tooling.

# Required: Pushover application token.
# Create an application at https://pushover.net/apps/build and paste its token here.
PUSHOVER_TOKEN=

# Required: your Pushover user key (shown on https://pushover.net after login).
PUSHOVER_USER=

# Optional settings (defaults shown):
#CHECK_INTERVAL=1h
#ALERT_INTERVAL=10m
#LOG_LEVEL=info          # debug|info|warn|error
#TARGET_URL=https://service.berlin.de/dienstleistung/318998/
#STATE_FILE=state.json
#HISTORY_FILE=history.jsonl
#LOG_FILE=app.log
